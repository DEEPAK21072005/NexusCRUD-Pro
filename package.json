{
  "name": "nexus-crud-pro",
  "version": "2.0.0",
  "description": "Enterprise-Grade RESTful CRUD Engine & Real-Time Analytics Dashboard built with Express.js, Clean Layered Architecture, Zod Validation, OpenAPI/Swagger 3.0, and Vitest.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\" \"public/**/*.{js,css,html}\""
  },
  "keywords": [
    "express",
    "crud",
    "rest-api",
    "clean-architecture",
    "zod-validation",
    "openapi",
    "swagger",
    "vitest",
    "docker",
    "dashboard",
    "enterprise"
  ],
  "author": "DEEPAK21072005 <polisettideepak14348@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.1.6",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
